# FalkorDB Cloud connection details
FALKOR_HOST=
FALKOR_PORT=
FALKOR_USER=falkordb
FALKOR_PASS=
# Free-tier instances use false; set true if the dashboard requires TLS
FALKOR_SSL=false

# LaserData Cloud connection target used by laser-sdk.
# Recommended: <scoped-token>@<exact-deployment-hostname>
# Alternative: root:<rotated-password>@<exact-deployment-hostname>:8090
# Use the bare target only; do not include iggy:// or another URL scheme.
LASER_CONNECTION_STRING=
# Stable logical stream containing alerts, hypotheses, proposals, and resolutions.
LASER_STREAM=sentry

# RocketRide Cloud and the Anthropic key used inside runbook.pipe
ROCKETRIDE_APIKEY=
ROCKETRIDE_URI=
ROCKETRIDE_ANTHROPIC_KEY=

# Guild.ai values must come from the event mentor or Guild; do not invent them.
GUILD_API_KEY=
GUILD_WORKSPACE_ID=
# Submission gate: this must be true before submission, after the real Guild
# handoff and human-review path is configured and verified.
GUILD_REQUIRED=false
# Development-only continuity switch. Local review remains non-qualifying and
# does not satisfy the sponsor integration requirement.
GUILD_ALLOW_LOCAL_FALLBACK=true

# Optional enrichment, enabled only after all required sponsors are green
LINKUP_API_KEY=

# Optional post-submission security scan
SNYK_TOKEN=
