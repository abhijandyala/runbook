{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      }
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "instructions": [
          "You are the reasoning runtime for runbook, an incident-response copilot.",
          "Every request is a JSON TaskEnvelope containing role, payload, and trace_id.",
          "For role diagnostician in grounded_candidates mode, explain the supplied ranked candidates without changing their deterministic fields.",
          "For role diagnostician in alert_only_guess mode, use only the raw alert and return an honest low-confidence guess; never imply graph evidence exists.",
          "For role remediator, justify only the supplied whitelisted action and never invent another action.",
          "Your final response must be one valid JSON object and nothing else: no Markdown, no code fence, no preamble, and no trailing commentary.",
          "Use double quotes around every JSON property name and string. Preserve trace_id in the response."
        ],
        "max_waves": 2,
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
    {
      "id": "llm_anthropic_1",
      "provider": "llm_anthropic",
      "config": {
        "profile": "claude-haiku-4-5",
        "claude-haiku-4-5": {
          "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}",
          "extendedThinking": false
        },
        "parameters": {}
      },
      "control": [
        {
          "classType": "llm",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "config": {
        "type": "memory_internal"
      },
      "control": [
        {
          "classType": "memory",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "agent_rocketride_1"
        }
      ]
    }
  ],
  "source": "chat_1",
  "project_id": "5621bc5a-2ff1-4021-8592-81383fa4890f",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}
